# EduSphere Backend Environment Variables Example

# Server & Database Configuration
PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/edusphere
JWT_SECRET=your_strong_random_secret

# OTP Policy Settings
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=120

# Resend Transactional Email Provider (Primary)
RESEND_API_KEY=

# Sender Email Address (Defaults to EduSphere <onboarding@resend.dev> if using Resend sandbox)
SMTP_FROM=

# Optional Legacy SMTP Fallback (SendGrid, Postmark, Mailgun, Amazon SES, Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WebRTC STUN & TURN Relay Server Configuration
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=
